{
  "name": "@hughescr/oxlint-config-default",
  "version": "0.10.0",
  "description": "Shared explicit-rule Oxlint config for JavaScript and TypeScript",
  "repository": {
    "type": "git",
    "url": "git://github.com/hughescr/oxlint-config-default.git"
  },
  "license": "BSD-3-Clause",
  "author": "Craig Hughes <craig.npm@rungie.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./package-json": {
      "types": "./package-json.d.mts",
      "default": "./package-json.mjs"
    }
  },
  "files": [
    "index.d.mts",
    "index.mjs",
    "package-json.d.mts",
    "package-json.mjs",
    "rules.mjs",
    "rules.d.mts",
    "plugins",
    "ast-grep"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test/self-check.mjs",
    "build:types": "node build-types.mjs",
    "prepack": "node build-types.mjs",
    "lint": "node node_modules/oxlint/bin/oxlint -c oxlint.config.ts --deny-warnings build-types.mjs index.mjs package-json.mjs rules.mjs plugins test/self-check.mjs",
    "postversion": "git commit -m \"Bump package version to $npm_package_version\" package.json; git flow release start $npm_package_version; git flow release finish -m $npm_package_version $npm_package_version; git checkout develop; git merge main"
  },
  "peerDependencies": {
    "oxlint": ">=1.94.0",
    "tsrs": "*"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.5",
    "@hughescr/eslint-plugin-test-hygiene": "^1.0.0",
    "@hughescr/oxlint-plugin-module-boundaries": "^2.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-lodash-es": "^1.2.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-package-json": "^1.14.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^64.0.0"
  },
  "devDependencies": {
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
